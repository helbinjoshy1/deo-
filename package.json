{
  "name": "skinwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.5.0 <25" },
  "scripts": {
    "dev": "node --use-env-proxy --import tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --use-env-proxy --import tsx server.ts",
    "test": "node --import tsx --test src/lib/analysis.test.ts tests/server.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
